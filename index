<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>週間高效率讀書規劃表</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Microsoft JhengHei", sans-serif;
      background-color: #f4f6f9;
      color: #2c3e50;
      margin: 0;
      padding: 16px;
    }
    /* 密碼鎖定畫面樣式 */
    #lockScreen {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background-color: #2c3e50;
      display: flex;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }
    .lock-box {
      background: #ffffff;
      padding: 32px 28px;
      border-radius: 12px;
      box-shadow: 0 8px 25px rgba(0,0,0,0.2);
      text-align: center;
      max-width: 340px;
      width: 90%;
    }
    .lock-box h2 {
      margin: 0 0 10px;
      font-size: 20px;
      color: #2c3e50;
    }
    .lock-box p {
      margin: 0 0 20px;
      font-size: 14px;
      color: #7f8c8d;
    }
    .lock-box input {
      width: 100%;
      box-sizing: border-box;
      padding: 12px;
      font-size: 16px;
      border: 2px solid #dfe6e9;
      border-radius: 8px;
      text-align: center;
      margin-bottom: 14px;
      outline: none;
    }
    .lock-box input:focus {
      border-color: #3498db;
    }
    .lock-box button {
      width: 100%;
      background-color: #3498db;
      padding: 12px;
      font-size: 16px;
    }
    .lock-box button:hover {
      background-color: #2980b9;
    }
    #errorMsg {
      color: #e74c3c;
      font-size: 13px;
      margin-top: 10px;
      min-height: 18px;
    }

    /* 主內容區樣式 */
    .container {
      max-width: 1150px;
      margin: 0 auto;
      background: #ffffff;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.08);
      padding: 24px;
      display: none;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      border-bottom: 2px solid #ecf0f1;
      padding-bottom: 15px;
      margin-bottom: 20px;
      gap: 12px;
    }
    .header h1 {
      margin: 0;
      font-size: 22px;
      color: #2c3e50;
    }
    .header p {
      margin: 5px 0 0;
      font-size: 14px;
      color: #7f8c8d;
    }
    .btn-group {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    button {
      background-color: #e74c3c;
      color: white;
      border: none;
      padding: 10px 14px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: bold;
      cursor: pointer;
      transition: background 0.2s;
    }
    button:hover {
      background-color: #c0392b;
    }
    button.sync-btn {
      background-color: #27ae60;
    }
    button.sync-btn:hover {
      background-color: #219150;
    }
    button.lock-btn {
      background-color: #34495e;
    }
    button.lock-btn:hover {
      background-color: #2c3e50;
    }
    #syncStatus {
      font-size: 14px;
      font-weight: bold;
      margin-bottom: 12px;
      min-height: 20px;
    }
    .progress-box {
      background: #ecf0f1;
      border-radius: 8px;
      padding: 14px 18px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }
    .progress-bar-bg {
      flex-grow: 1;
      min-width: 200px;
      height: 16px;
      background: #dcdde1;
      border-radius: 8px;
      overflow: hidden;
    }
    .progress-bar-fill {
      height: 100%;
      width: 0%;
      background: #27ae60;
      transition: width 0.3s ease;
    }
    .table-wrapper {
      width: 100%;
      overflow-x: auto;
      margin-bottom: 25px;
      border-radius: 6px;
    }
    table {
      width: 100%;
      min-width: 900px;
      border-collapse: collapse;
      font-size: 14px;
    }
    th {
      background-color: #34495e;
      color: white;
      padding: 12px 8px;
      text-align: center;
      white-space: nowrap;
    }
    td {
      border: 1px solid #dfe6e9;
      padding: 10px 8px;
      text-align: center;
      vertical-align: middle;
    }
    .time-col { font-weight: bold; width: 110px; background: #f8f9fa; white-space: nowrap; }
    .dur-col { width: 75px; color: #636e72; background: #f8f9fa; white-space: nowrap; }
    .note-col { text-align: left; width: 210px; font-size: 13px; color: #34495e; background: #f8f9fa; }
    
    /* 科目色塊 */
    .sub-science { background-color: #fadbd8; font-weight: bold; }
    .sub-social { background-color: #fcf3cf; font-weight: bold; }
    .sub-math { background-color: #d6eaf8; }
    .sub-lang { background-color: #d5f5e3; }
    .sub-routine { background-color: #f2f4f4; color: #7f8c8d; }
    .sub-rest { background-color: #e8f8f5; color: #16a085; }

    .task-label {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
    }
    .task-label input[type="checkbox"] {
      width: 18px;
      height: 18px;
      cursor: pointer;
      accent-color: #27ae60;
    }
    .completed {
      text-decoration: line-through;
      opacity: 0.5;
    }
    .stats-title {
      font-size: 16px;
      font-weight: bold;
      margin-bottom: 10px;
      color: #2c3e50;
    }
    .stats-table {
      min-width: 600px;
    }
  </style>
</head>
<body>

<!-- 密碼驗證畫面 -->
<div id="lockScreen">
  <div class="lock-box">
    <h2>🔒 私人讀書規劃表</h2>
    <p>請輸入密碼以檢視與編輯進度</p>
    <input type="password" id="pwdInput" placeholder="請輸入密碼" onkeypress="handleEnter(event)">
    <button onclick="checkPassword()">解鎖進入</button>
    <div id="errorMsg"></div>
  </div>
</div>

<!-- 課表主畫面 -->
<div class="container" id="mainContent">
  <div class="header">
    <div>
      <h1>📚 週間高效率讀書規劃表</h1>
      <p>作息基準：07:15 上學 / 15:55 放學 / 16:30 補習（已針對理化與社會三科加權）</p>
    </div>
    <div class="btn-group">
      <button class="sync-btn" onclick="syncToGoogleScript()">☁️ 同步至 Google 試算表</button>
      <button class="lock-btn" onclick="lockPage()">🔒 鎖定</button>
      <button onclick="resetChecks()">重置本週進度</button>
    </div>
  </div>

  <div id="syncStatus"></div>

  <div class="progress-box">
    <strong>本週自主讀書完成度：</strong>
    <div class="progress-bar-bg">
      <div class="progress-bar-fill" id="progressBar"></div>
    </div>
    <span id="progressText" style="font-weight:bold; min-width: 85px; text-align:right;">0% (0/20)</span>
  </div>

  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>時段</th>
          <th>長度</th>
          <th>星期一</th>
          <th>星期二</th>
          <th>星期三</th>
          <th>星期四</th>
          <th>星期五</th>
          <th>時段規劃重點</th>
        </tr>
      </thead>
      <tbody id="scheduleBody"></tbody>
    </table>
  </div>

  <div class="stats-title">📊 每週自主讀書時間分配統計 (不含在校與補習)</div>
  <div class="table-wrapper">
    <table class="stats-table">
      <thead>
        <tr>
          <th>科目類別</th>
          <th>每週自主時數</th>
          <th>佔比</th>
          <th>設計說明</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="sub-science">理化 (重點加權)</td>
          <td>135 分鐘 (2.25 hr)</td>
          <td>25%</td>
          <td style="text-align:left;">安排三次晚間主力時段，確保理解與題目演練</td>
        </tr>
        <tr>
          <td class="sub-social">社會三科 (歷史/地理/公民)</td>
          <td>225 分鐘 (3.75 hr)</td>
          <td>42%</td>
          <td style="text-align:left;">三科獨立分天突破 + 週三週五統整，記憶最紮實</td>
        </tr>
        <tr>
          <td class="sub-math">數學</td>
          <td>90 分鐘 (1.5 hr)</td>
          <td>17%</td>
          <td style="text-align:left;">週二、週四晚間維持計算手感</td>
        </tr>
        <tr>
          <td class="sub-lang">英文 & 國語</td>
          <td>90 分鐘 (1.5 hr)</td>
          <td>17%</td>
          <td style="text-align:left;">全數配置於晨讀時段，不佔用晚間黃金時間</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script>
  // ▼ 專屬密碼與 Google Apps Script 網址設定 ▼
  const MY_PASSWORD = "2026";
  const GAS_URL = "https://script.google.com/macros/s/AKfycbz9ZMLC-XFMCpcie8_GyYIud2Xma7hsHpNaI_u3OjjPJjviKWEegVYKscEUxiKJ-G2_8g/exec";

  function checkAuth() {
    if (sessionStorage.getItem("isUnlocked") === "true") {
      document.getElementById("lockScreen").style.display = "none";
      document.getElementById("mainContent").style.display = "block";
      renderTable();
    } else {
      document.getElementById("lockScreen").style.display = "flex";
      document.getElementById("mainContent").style.display = "none";
      document.getElementById("pwdInput").focus();
    }
  }

  function checkPassword() {
    const input = document.getElementById("pwdInput").value;
    const errorMsg = document.getElementById("errorMsg");
    if (input === MY_PASSWORD) {
      sessionStorage.setItem("isUnlocked", "true");
      errorMsg.textContent = "";
      document.getElementById("pwdInput").value = "";
      checkAuth();
    } else {
      errorMsg.textContent = "❌ 密碼錯誤，請再試一次！";
      document.getElementById("pwdInput").value = "";
      document.getElementById("pwdInput").focus();
    }
  }

  function handleEnter(event) {
    if (event.key === "Enter") {
      checkPassword();
    }
  }

  function lockPage() {
    sessionStorage.removeItem("isUnlocked");
    checkAuth();
  }

  const scheduleData = [
    ["06:30 - 07:00", "30 分鐘", "英文 (單字/片語)", "國語 (文言/成語)", "英文 (閱讀測驗)", "國語 (字音字形)", "英/國 週複習", "黃金晨讀：利用大腦最清醒時背誦"],
    ["07:15 - 15:55", "在校時間", "學校正規課程", "學校正規課程", "學校正規課程", "學校正規課程", "學校正規課程", "上課專心聽講，下課盡量先寫作業"],
    ["15:55 - 16:30", "35 分鐘", "整理今日筆記 + 點心", "預習補習班講義 + 點心", "整理今日筆記 + 點心", "預習補習班講義 + 點心", "本週學校作業收尾", "緩衝時間：補充能量、消化當天所學"],
    ["16:30 - 21:00", "補習時段", "補習班課程 / 晚餐", "補習班課程 / 晚餐", "補習班課程 / 晚餐", "補習班課程 / 晚餐", "補習班課程 / 晚餐", "緊跟補習班進度，有問題當場問"],
    ["21:00 - 21:30", "30 分鐘", "洗澡 / 休息放空", "洗澡 / 休息放空", "洗澡 / 休息放空", "洗澡 / 休息放空", "洗澡 / 休息放空", "完全遠離書本，讓大腦重開機"],
    ["21:30 - 22:15", "45 分鐘", "[重點] 理化 (觀念+計算)", "[重點] 地理 (圖表+區域)", "[重點] 理化 (實驗+題型)", "[重點] 公民 (法規+經濟)", "[重點] 理化 (週複習/錯題)", "主力時段 1：高專注度攻克理科與社會"],
    ["22:15 - 23:00", "45 分鐘", "[重點] 歷史 (時間軸整理)", "數學 (題型演練)", "[重點] 社會三科錯題本", "數學 (題型演練)", "[重點] 歷史/地理/公民統整", "主力時段 2：睡前記憶鞏固黃金期"],
    ["23:00 準時", "就寢", "睡覺休息", "睡覺休息", "睡覺休息", "睡覺休息", "睡覺休息", "確保充足睡眠，隔天 06:30 才有精神"]
  ];

  const studyRows = [0, 2, 5, 6];

  function getSubjectClass(text) {
    if (text.includes("理化")) return "sub-science";
    if (text.includes("歷史") || text.includes("地理") || text.includes("公民") || text.includes("社會")) return "sub-social";
    if (text.includes("數學")) return "sub-math";
    if (text.includes("英文") || text.includes("國語") || text.includes("英/國")) return "sub-lang";
    if (text.includes("洗澡") || text.includes("睡覺")) return "sub-rest";
    return "sub-routine";
  }

  function renderTable() {
    const tbody = document.getElementById("scheduleBody");
    tbody.innerHTML = "";
    const savedChecks = JSON.parse(localStorage.getItem("studyChecks_v1") || "{}");

    scheduleData.forEach((row, rIdx) => {
      const tr = document.createElement("tr");
      
      row.forEach((cellText, cIdx) => {
        const td = document.createElement("td");
        if (cIdx === 0) {
          td.className = "time-col";
          td.textContent = cellText;
        } else if (cIdx === 1) {
          td.className = "dur-col";
          td.textContent = cellText;
        } else if (cIdx === 7) {
          td.className = "note-col";
          td.textContent = cellText;
        } else {
          td.className = getSubjectClass(cellText);
          if (studyRows.includes(rIdx)) {
            const taskId = `task_${rIdx}_${cIdx}`;
            const isChecked = savedChecks[taskId] ? "checked" : "";
            const textClass = savedChecks[taskId] ? "completed" : "";
            td.innerHTML = `
              <label class="task-label">
                <input type="checkbox" id="${taskId}" ${isChecked} onchange="toggleTask('${taskId}')">
                <span class="${textClass}">${cellText}</span>
              </label>
            `;
          } else {
            td.textContent = cellText;
          }
        }
        tr.appendChild(td);
      });
      tbody.appendChild(tr);
    });
    updateProgress();
  }

  function toggleTask(taskId) {
    const savedChecks = JSON.parse(localStorage.getItem("studyChecks_v1") || "{}");
    const checkbox = document.getElementById(taskId);
    savedChecks[taskId] = checkbox.checked;
    localStorage.setItem("studyChecks_v1", JSON.stringify(savedChecks));
    
    const span = checkbox.nextElementSibling;
    if (checkbox.checked) {
      span.classList.add("completed");
    } else {
      span.classList.remove("completed");
    }
    updateProgress();
  }

  function updateProgress() {
    const checkboxes = document.querySelectorAll('input[type="checkbox"]');
    const total = checkboxes.length;
    let checkedCount = 0;
    checkboxes.forEach(cb => { if (cb.checked) checkedCount++; });
    
    const percent = total === 0 ? 0 : Math.round((checkedCount / total) * 100);
    document.getElementById("progressBar").style.width = percent + "%";
    document.getElementById("progressText").textContent = `${percent}% (${checkedCount}/${total})`;
  }

  function resetChecks() {
    if (confirm("確定要清除本週所有的打勾紀錄嗎？")) {
      localStorage.removeItem("studyChecks_v1");
      renderTable();
    }
  }

  // 傳送課表與目前打勾進度至你的 Google Apps Script
  function syncToGoogleScript() {
    const statusEl = document.getElementById("syncStatus");
    statusEl.style.color = "#e67e22";
    statusEl.textContent = "⏳ 正在連線至 Google Apps Script 同步資料...";

    const savedChecks = JSON.parse(localStorage.getItem("studyChecks_v1") || "{}");
    const exportRows = scheduleData.map((row, rIdx) => {
      return row.map((cell, cIdx) => {
        if (cIdx >= 2 && cIdx <= 6 && studyRows.includes(rIdx)) {
          const isDone = savedChecks[`task_${rIdx}_${cIdx}`];
          return (isDone ? "[已完成] " : "[未完成] ") + cell;
        }
        return cell;
      });
    });

    fetch(GAS_URL, {
      method: "POST",
      mode: "no-cors",
      headers: {
        "Content-Type": "text/plain;charset=utf-8"
      },
      body: JSON.stringify({
        action: "syncSchedule",
        updatedAt: new Date().toLocaleString("zh-TW"),
        scheduleData: exportRows
      })
    })
    .then(() => {
      statusEl.style.color = "#27ae60";
      statusEl.textContent = "✅ 已傳送至你的 Google Apps Script！（若試算表未更新，請確認 GAS 內有設定 doPost 接收函式）";
    })
    .catch(err => {
      statusEl.style.color = "#e74c3c";
      statusEl.textContent = "❌ 同步失敗：" + err.message;
    });
  }

  checkAuth();
</script>

</body>
</html>
